/* ===================================================================
   PASSO 1: RESET CSS E ESTILOS GERAIS DO CORPO (body)
   
   EXPLICAÇÃO DE PROPRIEDADES:
   - background-color: Define a cor do fundo da página.
   - color: Define a cor do texto da página.
   
   COMO ESCREVER CORES EM CSS:
   Podemos usar códigos hexadecimais (Ex: #f4f4f9 ou #333333).
   
   SUA TAREFA:
   1. Preencha background-color com a cor cinza-claro (#f4f4f9).
   2. Preencha color com a cor grafite (#333333).
   =================================================================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    /* DIGITE A PROPRIEDADE E O VALOR PARA A COR DE FUNDO DO BODY ABAIXO: */
    background-color: ________________________;

    /* DIGITE A PROPRIEDADE E O VALOR PARA A COR DO TEXTO DO BODY ABAIXO: */
    color: ________________________;
}


/* ===================================================================
   PASSO 2: CABEÇALHO (header) E PROPRIEDADES DE BORDAS
   
   ESTRUTURA DE UMA BORDA EM CSS:
   Sintaxe completa: border-bottom: [largura] [estilo] [cor];
   
   COMPONENTES DA BORDA:
   - Largura: medido em píxeis (ex: 5px, 2px).
   - Estilo: solid (linha contínua), dashed (tracejada), dotted (pontilhada).
   - Cor: código hexadecimal da cor (ex: #1d3557).
   
   Exemplo visual da sintaxe:
   border-bottom: 5px solid #1d3557;
   
   SUA TAREFA:
   1. Defina a cor de fundo (background-color) do header para vermelho (#e63946).
   2. Defina uma borda inferior (border-bottom) de 5px, estilo solid, na cor azul-escuro (#1d3557).
   =================================================================== */
header {
    /* DIGITE O BACKGROUND-COLOR DO HEADER ABAIXO: */
    background-color: ________________________;

    color: #ffffff;
    padding: 30px 15px;
    text-align: center;

    /* DIGITE O BORDER-BOTTOM DO HEADER ABAIXO: */
    border-bottom: ________________________;
}


/* ===================================================================
   PASSO 3: CONTAINER E TÍTULO DA SEÇÃO (h2)
   
   EXPLICAÇÃO DA BORDA LATERAL:
   A propriedade "border-left" desenha uma linha vertical apenas no lado esquerdo do elemento.
   Sintaxe: border-left: [largura] [estilo] [cor];
   
   SUA TAREFA:
   1. Aplique uma borda à esquerda (border-left) no h2 de 6px, estilo solid, na cor vermelha (#e63946).
   =================================================================== */
.container {
    max-width: 1100px;
    margin: 30px auto;
    padding: 0 15px;
}

.container h2 {
    margin-bottom: 25px;
    padding-left: 12px;

    /* DIGITE O BORDER-LEFT DO H2 ABAIXO: */
    border-left: ________________________;
}


/* ===================================================================
   PASSO 4: LAYOUT EM GRID DA VITRINE (.grid-produtos)
   Layout já pré-configurado com CSS Grid Responsive.
   =================================================================== */
.grid-produtos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
}


/* ===================================================================
   PASSO 5: ESTILIZAÇÃO DOS CARDS DE PRODUTOS (.card-produto)
   
   EXPLICAÇÃO SOBRE BORDAS COMPLETAS:
   A propriedade "border" aplica uma borda nos 4 lados do elemento ao mesmo tempo.
   Sintaxe: border: [largura] [estilo] [cor];
   
   SUA TAREFA:
   1. Defina o fundo do card (background-color) para branco (#ffffff).
   2. Crie uma borda completa (border) de 1px, estilo solid, na cor cinza (#dddddd).
   =================================================================== */
.card-produto {
    /* DIGITE O BACKGROUND-COLOR DO CARD ABAIXO: */
    background-color: ________________________;

    padding: 15px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);

    /* DIGITE O BORDER DO CARD ABAIXO: */
    border: ________________________;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.card-produto img {
    width: 100%;
    height: 170px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 12px;
}

.card-produto h3 {
    font-size: 1.2rem;
    color: #1d3557;
    margin-bottom: 8px;
}

.card-produto p {
    font-size: 0.9rem;
    color: #666666;
    margin-bottom: 15px;
}


/* ===================================================================
   PASSO 6: PREÇO E BOTÃO DO WHATSAPP (.btn-whatsapp)
   
   SUA TAREFA:
   1. Aplique a cor oficial do WhatsApp (#25d366) no fundo (background-color) do botão.
   =================================================================== */
.preco {
    font-size: 1.3rem;
    font-weight: bold;
    color: #2a9d8f;
    margin-bottom: 15px;
}

.btn-whatsapp {
    /* DIGITE O BACKGROUND-COLOR DO BOTÃO WHATSAPP ABAIXO: */
    background-color: ________________________;

    color: #ffffff;
    padding: 12px;
    text-decoration: none;
    border-radius: 6px;
    text-align: center;
    font-weight: bold;
    display: block;
    transition: background-color 0.3s;
}

.btn-whatsapp:hover {
    background-color: #1da851;
}


